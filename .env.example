# Sao chep file nay thanh ".env" roi dien gia tri that, KHONG commit file .env len git

PORT=3000

# Ten dang nhap admin
ADMIN_USERNAME=admin

# Mat khau admin da duoc ma hoa bang bcrypt.
# Chay: npm run hash-password -- "mat-khau-cua-ban"
# roi dan chuoi hash in ra vao day.
ADMIN_PASSWORD_HASH=

# Chuoi bi mat dung de ky session, dien mot chuoi ngau nhien dai it nhat 32 ky tu
SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-va-kho-doan

# Dat la "true" khi chay that su sau HTTPS/reverse proxy (bat cookie secure)
TRUST_PROXY_HTTPS=false
